# ============ ВЫБОР ДВИЖКА ============
# anthropic     — Claude API, лучшее качество (платно, ~$0.02-0.20 за разбор)
# openai_compat — бесплатные варианты: OpenRouter или локальная Ollama
AI_PROVIDER=anthropic

# ============ Вариант 1: Claude API ============
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
AI_CHECKER_MODEL=claude-sonnet-5

# ============ Вариант 2а: Google AI Studio (бесплатный tier, без карты) ============
# Ключ: https://aistudio.google.com/apikey
# AI_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_COMPAT_API_KEY=AIza...
# AI_CHECKER_MODEL=gemini-2.5-flash

# ============ Вариант 2б: OpenRouter (бесплатных моделей мало, лимиты в день) ============
# Ключ: https://openrouter.ai/keys
# Актуальный список: https://openrouter.ai/models (фильтры: free + image input)
# AI_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=sk-or-...
# AI_CHECKER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ============ Вариант 2в: Ollama (локально, совсем бесплатно) ============
# Установка: https://ollama.com  затем:  ollama pull qwen2.5vl:7b
# AI_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=ollama
# AI_CHECKER_MODEL=qwen2.5vl:7b

# ============ Исходящий прокси (если провайдер блокирует по IP/гео) ============
# OpenRouter и др. отдают 403 с некоторых IP (например, российских).
# Прокидывает только сам запрос к модели через SOCKS5/HTTP-прокси —
# требует `uv add "httpx[socks]"` для socks5h://.
# OUTBOUND_PROXY_URL=socks5h://127.0.0.1:1080
